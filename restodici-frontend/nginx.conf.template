server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  resolver 127.0.0.11 valid=30s ipv6=off;

  # Variable obligatoire pour le DNS Docker Swarm, mais avec variable
  # nginx ignore le path du proxy_pass — on laisse donc l'URI client intacte
  # (/api/auth/register → backend:3000/api/auth/register).
  set $api_upstream "${API_UPSTREAM}";

  location = /api {
    proxy_pass $api_upstream/api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /api/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /socket.io/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # index.html ne doit JAMAIS être caché par le navigateur : c'est le seul
  # fichier sans hash de contenu dans le nom, et il référence les assets
  # hashés du build courant. Un dist/ est entièrement remplacé à chaque
  # déploiement (pas de rétention des anciens fichiers hashés) — un
  # index.html caché pointerait vers des .js/.css qui n'existent plus
  # (404), ce qui casse silencieusement tout le style et le JS de la page.
  location = /index.html {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  # Caching agressif pour les assets statiques (noms hashés par build → un
  # nouveau build a de nouveaux noms, jamais de collision avec l'ancien cache)
  location ~* \.(?:css|js|woff2?|eot|ttf|otf|svg|png|jpg|jpeg|gif|ico|webp)$ {
    expires 1y;
    access_log off;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
}
